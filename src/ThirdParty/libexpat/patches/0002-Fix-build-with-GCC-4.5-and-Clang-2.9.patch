From 938d3fa8c757bb73852ced84cda5dd06f4b34509 Mon Sep 17 00:00:00 2001
From: Peter Zhigalov <peter.zhigalov@gmail.com>
Date: Fri, 25 Sep 2026 01:12:12 +0700
Subject: [PATCH 2/2] Fix build with GCC < 4.5 and Clang < 2.9

---
 expat/lib/expat_external.h | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/expat/lib/expat_external.h b/expat/lib/expat_external.h
index cf80f960..dbed8299 100644
--- a/expat/lib/expat_external.h
+++ b/expat/lib/expat_external.h
@@ -128,9 +128,14 @@
 
 /* Marks a function that Expat still provides but that callers should move off
    of. */
-#  if defined(__clang__) || defined(__GNUC__)
+#  if (defined(__clang__) && ((__clang_major__ > 2)                            \
+      || (__clang_major__ == 2 && __clang_minor__ >= 9)))                      \
+      || (defined(__GNUC__) && ((__GNUC__ > 4)                                 \
+      || (__GNUC__ == 4 && __GNUC_MINOR__ >= 5)))
 #    define XML_ATTR_DEPRECATED(message)                                       \
       __attribute__((__deprecated__(message)))
+#  elif defined(__clang__) || defined(__GNUC__)
+#    define XML_ATTR_DEPRECATED(message) __attribute__((__deprecated__))
 #  elif defined(_MSC_VER)
 #    define XML_ATTR_DEPRECATED(message) __declspec(deprecated(message))
 #  else
-- 
2.47.3

